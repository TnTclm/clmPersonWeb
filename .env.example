# ============================================================
# 环境变量模板 —— 复制成 .env 再填自己的值：
#   cp .env.example .env
# .env 已经被 .gitignore 挡住，不会进仓库；这个模板会进。
# ============================================================

# 后端监听端口
PORT=8080

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=clm_blog

# ---------- Redis ----------
REDIS_ADDR=127.0.0.1:6379

# ---------- RabbitMQ ----------
# 默认账号 guest/guest 只能在 localhost 用；用 Docker 起的可以用 admin/123456
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ---------- 安全 ----------
# JWT 签名密钥：上线前一定换成随机长字符串（比如 openssl rand -hex 32 生成的）
JWT_SECRET=please-change-me-to-a-long-random-string

# 博主的用户 ID：发说说 / 发相册 / 看通知都是 TA
OWNER_ID=4

# ---------- 主页图片墙 ----------
# 照片放哪个文件夹（相对仓库根目录）
PICTURES_DIR=./pictures

# ---------- 日志 / 运行模式 ----------
# 日志级别：debug（本地，什么都打）/ info（线上，只留关键日志）
LOG_LEVEL=debug
# gin 运行模式：debug（本地，会打印路由列表）/ release（线上，安静）
GIN_MODE=debug
